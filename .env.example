# GEMINI_API_KEY: Primary Google Gemini API key (supports pools via GEMINI_API_KEYS or GEMINI_API_KEY_2..10).
# AI Studio automatically injects GEMINI_API_KEY at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_API_KEYS=""

# GROQ_API_KEY: Groq ultra-fast inference key for chat, LokiCode, followups & games (supports GROQ_API_KEYS or GROQ_API_KEY_2..10).
GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_API_KEYS=""

# Additional Multi-Provider Fallback Chain Keys (all optional, rotated automatically if primary keys rate-limit):
CEREBRAS_API_KEY=""
SAMBANOVA_API_KEY=""
OPENROUTER_API_KEY=""
TOGETHER_API_KEY=""
FIREWORKS_API_KEY=""
MISTRAL_API_KEY=""
CODESTRAL_API_KEY=""
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
XAI_API_KEY=""
NVIDIA_API_KEY=""
ANTHROPIC_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PayPal Subscriptions REST API (Live Verification, 3-Day Trial Sync & Cancellation)
PAYPAL_MODE="live"
PAYPAL_CLIENT_ID="MY_PAYPAL_CLIENT_ID"
PAYPAL_CLIENT_SECRET="MY_PAYPAL_CLIENT_SECRET"
PAYPAL_WEBHOOK_ID="MY_PAYPAL_WEBHOOK_ID"
